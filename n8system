}
const INVITE_RE = /(?:discord\.gg|discordapp?\.com\/invite)\/\w+/i;
const URL_RE    = /(?:https?:\/\/|www\.)([^\s/]+)/gi;

function hasBlockedLink(text) {
  let m;
  URL_RE.lastIndex = 0;
  while ((m = URL_RE.exec(text)) !== null) {
    const host = m[1].toLowerCase().replace(/^www\./, "");
    if (!ALLOWED_DOMAINS.some(d => host === d || host.endsWith("." + d))) return true;
  }
  return false;
}
function hasBadWord(text) {
  const clean = normalize(text);
  return BAD_WORDS.some(w => w && clean.includes(normalize(w)));
}

async function auditExecutor(guild, action, targetId) {
  await sleep(1000);
  try {
    const logs = await guild.fetchAuditLogs({ limit: 6, type: action });
    const now = Date.now();
    for (const entry of logs.entries.values()) {
      if (now - entry.createdTimestamp > 15000) continue;
      if (targetId && entry.target?.id !== targetId) continue;
      return entry.executor;
    }
  } catch {}
  return null;
}

async function handleDestructive(guild, action, targetId, what) {
  if (!ANTI_NUKE || !inScope(guild.id)) return;
  const user = await auditExecutor(guild, action, targetId);
  if (!user || isTrusted(user.id, guild)) return;
  const key = `${guild.id}:${user.id}`;
  const now = Date.now();
  if (!nukeLog.has(key)) nukeLog.set(key, []);
  const dq = nukeLog.get(key).filter(t => now - t < NUKE_WINDOW_MS);
  dq.push(now);
  nukeLog.set(key, dq);
  await protLog(guild, `⚠️ <@${user.id}> نفّذ: ${what} (${dq.length}/${NUKE_LIMIT})`);
  if (dq.length >= NUKE_LIMIT) {
    nukeLog.set(key, []);
    await punishNuker(guild, user);
  }
}
async function punishNuker(guild, user) {
  let result;
  try {
    const member = guild.members.cache.get(user.id);
    if (NUKE_ACTION === "ban" || !member) {
      await guild.bans.create(user.id, { reason: "🛡️ حماية: تخريب" });
      result = "تم حظره";
    } else {
      const removable = member.roles.cache.filter(
        r => !r.managed && r.id !== guild.id && r.position < guild.members.me.roles.highest.position
      );
      await member.roles.remove(removable, "🛡️ حماية: تخريب");
      result = "تم سحب رتبه";
    }
  } catch (e) { result = `فشل (${e.message})`; }
  await protLog(guild, `🚨 **كشف تخريب** من <@${user.id}>: ${result}`);
}

async function raidPunish(member) {
  try {
