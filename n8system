// =================== Helpers ===================
const sleep = ms => new Promise(r => setTimeout(r, ms));

function normalize(text) {
  return text
    .replace(/[\u064B-\u065F\u0670]/g, "")
    .replace(/[أإآ]/g, "ا")
    .replace(/ة/g, "ه")
    .replace(/ى/g, "ي")
    .replace(/^سوره\s+/, "")
    .trim();
}

function findSurah(query) {
  query = query.trim();
  if (/^\d+$/.test(query)) {
    const n = parseInt(query);
    return (n >= 1 && n <= 114) ? n : null;
  }
  const q = normalize(query);
  if (!q) return null;
  const names = SURAHS.map(normalize);
  for (let i = 0; i < names.length; i++) {
    if (names[i] === q || names[i].replace(/^ال/, "") === q.replace(/^ال/, "")) return i + 1;
  }
  for (let i = 0; i < names.length; i++) {
    if (names[i].includes(q)) return i + 1;
  }
  return null;
}

