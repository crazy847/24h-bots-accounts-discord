// =================== Interaction Handler ===================
client.on("interactionCreate", async interaction => {

  // --- Buttons ---
  if (interaction.isButton()) {
    const id = interaction.customId;

    if (id === "dm_sub") {
      dmSubs.add(interaction.user.id); saveSubs();
      return interaction.reply({ content: "✅ تم تفعيل التنبيهات، بتوصلك الإعلانات بالخاص", ephemeral: true });
    }
    if (id === "dm_unsub") {
      dmSubs.delete(interaction.user.id); saveSubs();
      return interaction.reply({ content: "✅ تم إلغاء التنبيهات", ephemeral: true });
    }
    if (id === "adhkar_listen") {
      const embed  = interaction.message.embeds[0];
      const item   = ADHKAR.find(a => a.text === embed?.description);
      if (!item?.audio) return interaction.reply({ content: "❌ ما فيه صوت لهذا الذكر", ephemeral: true });
      if (!interaction.member.voice?.channel) return interaction.reply({ content: "❌ ادخل روم صوتي أول", ephemeral: true });
      await interaction.deferReply({ ephemeral: true });
      const conn = await ensureVoice(interaction);
      if (!conn) return;
      await playURL(interaction, conn, item.audio, true);
      return interaction.editReply("🎧 تم تشغيل الذكر");
    }

    // Trivia buttons
    if (id.startsWith("trivia_")) {
      const [, gameId, indexStr] = id.split("_");
      const game = triviaGames.get(gameId);
      if (!game) return interaction.reply({ content: "انتهت اللعبة", ephemeral: true });
      if (game.winner) return interaction.reply({ content: "فيه أحد سبقك 😅", ephemeral: true });
      if (game.wrongUsers.has(interaction.user.id)) return interaction.reply({ content: "جاوبت قبل، انتظر السؤال الجاي.", ephemeral: true });
      const idx = parseInt(indexStr);
      if (idx === game.item.answer) {
        game.winner = interaction.user.id;
        addPoint(interaction.guildId, interaction.user.id);
        const row = triviaRow(game.item, gameId, true, idx);
        await interaction.update({
          content: `🎉 ${interaction.user} جاوب صح! الإجابة: **${game.item.options[idx]}** (+1 نقطة)`,
          components: [row],
        });
        triviaGames.delete(gameId);
      } else {
        game.wrongUsers.add(interaction.user.id);
        await interaction.reply({ content: "❌ إجابة خاطئة!", ephemeral: true });
      }
    }

    // Broadcast confirm
    if (id.startsWith("bcast_confirm_")) {
      const authorId = id.replace("bcast_confirm_", "");
      if (interaction.user.id !== authorId) return interaction.reply({ content: "❌ هذا مو لك", ephemeral: true });
      const msg = pendingBroadcasts.get(interaction.message.id);
      if (!msg) return interaction.reply({ content: "❌ انتهت صلاحية الطلب", ephemeral: true });
      pendingBroadcasts.delete(interaction.message.id);
      await interaction.update({ content: "⏳ بدأ الإرسال... (اكتب /cancelbroadcast للإيقاف)", components: [] });
      runBroadcastAll(interaction.guild, interaction.channel, msg);
    }
    if (id.startsWith("bcast_cancel_")) {
      const authorId = id.replace("bcast_cancel_", "");
      if (interaction.user.id !== authorId) return interaction.reply({ content: "❌ هذا مو لك", ephemeral: true });
      pendingBroadcasts.delete(interaction.message.id);
      await interaction.update({ content: "تم الإلغاء.", components: [] });
    }
    return;
  }

  if (!interaction.isChatInputCommand()) return;

  const { commandName } = interaction;
  const guild  = interaction.guild;
  const member = interaction.member;

  // =================== Voice Commands ===================
  if (commandName === "join") {
    await interaction.deferReply();
    const conn = await ensureVoice(interaction);
    if (conn) await interaction.editReply(`✅ دخلت **${member.voice.channel.name}**`);
  }
  else if (commandName === "leave") {
    const conn = getVoiceConnection(guild.id);
    if (!conn) return interaction.reply("❌ أنا مو في أي روم صوتي");
    conn.destroy(); guildPlayers.delete(guild.id);
    await interaction.reply("👋 طلعت من الروم");
  }
  else if (commandName === "quran") {
    await interaction.deferReply();
    const q   = interaction.options.getString("surah");
    const num = findSurah(q);
    if (!num) return interaction.editReply("❌ ما لقيت السورة. اكتب رقمها (1-114) أو اسمها مثل: `/quran الكهف`");
    const rec = guildReciter.get(guild.id) || DEFAULT_RECITER;
    if (!rec.surahs.has(num)) return interaction.editReply(`❌ القارئ **${rec.name}** ما عنده هذي السورة`);
    const conn = await ensureVoice(interaction);
    if (!conn) return;
    const url = `${rec.server}${String(num).padStart(3, "0")}.mp3`;
    if (await playURL(interaction, conn, url, true))
      await interaction.editReply(`📖 تشغيل سورة **${SURAHS[num - 1]}** بصوت **${rec.name}**`);
  }
  else if (commandName === "reciter") {
    await interaction.deferReply();
    const name = interaction.options.getString("name");
    let items;
    try { items = await loadReciters(); }
    catch (e) { return interaction.editReply(`❌ ما قدرت أجيب قائمة القراء: ${e.message}`); }
    const q = normalize(name);
    const matches = items.filter(r => normalize(r.name).includes(q));
    if (!matches.length) return interaction.editReply("❌ ما لقيت قارئ بهذا الاسم");
    guildReciter.set(guild.id, matches[0]);
    let msg = `✅ تم اختيار القارئ **${matches[0].name}**`;
    if (matches.length > 1) msg += `\nنتائج ثانية: ${matches.slice(1, 6).map(r => r.name).join("، ")}`;
    await interaction.editReply(msg);
  }
  else if (commandName === "radio") {
    await interaction.deferReply();
    const conn = await ensureVoice(interaction);
    if (!conn) return;
    if (await playURL(interaction, conn, RADIO_URL, true))
      await interaction.editReply("📻 تشغيل إذاعة القرآن الكريم");
  }
  else if (commandName === "pause") {
    const player = guildPlayers.get(guild.id);
    if (player?.state.status === AudioPlayerStatus.Playing) { player.pause(); await interaction.reply("⏸️ تم الإيقاف المؤقت"); }
    else await interaction.reply("❌ ما فيه شي يشتغل");
  }
  else if (commandName === "resume") {
    const player = guildPlayers.get(guild.id);
    if (player?.state.status === AudioPlayerStatus.Paused) { player.unpause(); await interaction.reply("▶️ تمت المتابعة"); }
    else await interaction.reply("❌ ما فيه شي موقوف");
  }
  else if (commandName === "stop") {
    const player = guildPlayers.get(guild.id);
    if (player) { player.stop(); await interaction.reply("⏹️ تم الإيقاف"); }
    else await interaction.reply("❌ ما فيه شي يشتغل");
  }

  // =================== Moderation ===================
  else if (commandName === "ban") {
    if (!member.permissions.has(PermissionFlagsBits.BanMembers))
      return interaction.reply({ content: "❌ ما عندك صلاحية", ephemeral: true });
    const target = interaction.options.getMember("member");
    const reason = interaction.options.getString("reason") || "بدون سبب";
    await target.ban({ reason }).catch(async e => interaction.reply(`❌ فشل: ${e.message}`));
    await interaction.reply(`🔨 تم حظر **${target.user.tag}** | السبب: ${reason}`);
  }
  else if (commandName === "unban") {
    if (!member.permissions.has(PermissionFlagsBits.BanMembers))
      return interaction.reply({ content: "❌ ما عندك صلاحية", ephemeral: true });
    const uid = interaction.options.getString("user_id");
    try {
      const user = await client.users.fetch(uid);
      await guild.bans.remove(user);
      await interaction.reply(`✅ تم فك الحظر عن **${user.tag}**`);
    } catch { await interaction.reply("❌ ما لقيت هذا الشخص في قائمة المحظورين"); }
  }
  else if (commandName === "clear") {
    if (!member.permissions.has(PermissionFlagsBits.ManageMessages))
      return interaction.reply({ content: "❌ ما عندك صلاحية", ephemeral: true });
    const amount = interaction.options.getInteger("amount");
    await interaction.deferReply({ ephemeral: true });
    const deleted = await interaction.channel.bulkDelete(amount, true).catch(() => ({ size: 0 }));
    await interaction.editReply(`🧹 تم حذف ${deleted.size ?? amount} رسالة`);
  }
  else if (commandName === "kick") {
    if (!member.permissions.has(PermissionFlagsBits.KickMembers))
      return interaction.reply({ content: "❌ ما عندك صلاحية", ephemeral: true });
    const target = interaction.options.getMember("member");
    const reason = interaction.options.getString("reason") || "بدون سبب";
    await target.kick(reason).catch(async e => interaction.reply(`❌ فشل: ${e.message}`));
    await interaction.reply(`👢 تم طرد **${target.user.tag}** | السبب: ${reason}`);
  }
  else if (commandName === "timeout") {
    if (!member.permissions.has(PermissionFlagsBits.ModerateMembers))
      return interaction.reply({ content: "❌ ما عندك صلاحية", ephemeral: true });
    const target  = interaction.options.getMember("member");
    const minutes = interaction.options.getInteger("minutes");
    const reason  = interaction.options.getString("reason") || "بدون سبب";
    await target.timeout(minutes * 60000, reason).catch(async e => interaction.reply(`❌ فشل: ${e.message}`));
    await interaction.reply(`🔇 تم كتم **${target.user.tag}** لمدة ${minutes} دقيقة | السبب: ${reason}`);
  }
  else if (commandName === "untimeout") {
    if (!member.permissions.has(PermissionFlagsBits.ModerateMembers))
      return interaction.reply({ content: "❌ ما عندك صلاحية", ephemeral: true });
    const target = interaction.options.getMember("member");
    await target.timeout(null).catch(async e => interaction.reply(`❌ فشل: ${e.message}`));
    await interaction.reply(`🔊 تم فك الكتم عن **${target.user.tag}**`);
  }
  else if (commandName === "lock") {
    if (!member.permissions.has(PermissionFlagsBits.ManageChannels))
      return interaction.reply({ content: "❌ ما عندك صلاحية", ephemeral: true });
    await interaction.channel.permissionOverwrites.edit(guild.roles.everyone, { SendMessages: false });
    await interaction.reply("🔒 تم قفل الروم");
  }
  else if (commandName === "unlock") {
    if (!member.permissions.has(PermissionFlagsBits.ManageChannels))
      return interaction.reply({ content: "❌ ما عندك صلاحية", ephemeral: true });
    await interaction.channel.permissionOverwrites.edit(guild.roles.everyone, { SendMessages: null });
    await interaction.reply("🔓 تم فتح الروم");
  }
  else if (commandName === "slowmode") {
    if (!member.permissions.has(PermissionFlagsBits.ManageChannels))
      return interaction.reply({ content: "❌ ما عندك صلاحية", ephemeral: true });
    const seconds = interaction.options.getInteger("seconds");
    await interaction.channel.setRateLimitPerUser(seconds);
    await interaction.reply(seconds === 0 ? "✅ تم إيقاف الوضع البطيء" : `🐢 الوضع البطيء: ${seconds} ثانية`);
  }

  // =================== Line ===================
  else if (commandName === "setline") {
    if (!member.permissions.has(PermissionFlagsBits.ManageChannels))
      return interaction.reply({ content: "❌ ما عندك صلاحية", ephemeral: true });
    lineChannels.add(interaction.channel.id); saveLineChannels();
    await interaction.reply("✅ تم تفعيل الخط التلقائي");
  }
  else if (commandName === "unsetline") {
    if (!member.permissions.has(PermissionFlagsBits.ManageChannels))
      return interaction.reply({ content: "❌ ما عندك صلاحية", ephemeral: true });
    lineChannels.delete(interaction.channel.id); saveLineChannels();
    await interaction.reply("✅ تم إيقاف الخط التلقائي");
  }

  // =================== Games ===================
  else if (commandName === "trivia") {
    const item   = QUESTIONS[Math.floor(Math.random() * QUESTIONS.length)];
    const gameId = `${interaction.id}`;
    triviaGames.set(gameId, { item, winner: null, wrongUsers: new Set() });
    const row = triviaRow(item, gameId, false, -1);
    const msg = await interaction.reply({
      content: `❓ **${item.q}**\n(عندكم ٢٠ ثانية)`,
      components: [row], fetchReply: true,
    });
    setTimeout(async () => {
      const game = triviaGames.get(gameId);
      if (!game || game.winner) return;
      triviaGames.delete(gameId);
      const correct = item.options[item.answer];
      const disabledRow = triviaRow(item, gameId, true, -1);
      await msg.edit({ content: `⏰ انتهى الوقت! الإجابة الصحيحة: **${correct}**`, components: [disabledRow] }).catch(() => {});
    }, 20000);
  }
  else if (commandName === "word") {
    if (scrambleGames.has(interaction.channel.id))
      return interaction.reply("❌ فيه لعبة شغالة في هذي القناة!");
    const word = WORDS[Math.floor(Math.random() * WORDS.length)];
    let letters = [...word];
    while (letters.join("") === word) letters.sort(() => Math.random() - 0.5);
    scrambleGames.set(interaction.channel.id, word);
    await interaction.reply(`🔤 رتّب الحروف: **${letters.join(" - ")}**\n(عندكم ٣٠ ثانية، اكتبوا الإجابة في الشات)`);
    setTimeout(() => {
      if (scrambleGames.get(interaction.channel.id) === word) {
        scrambleGames.delete(interaction.channel.id);
        interaction.channel.send(`⏰ انتهى الوقت! الكلمة كانت: **${word}**`).catch(() => {});
      }
    }, 30000);
  }
  else if (commandName === "top") {
    const scores = loadScores()[guild.id] || {};
    if (!Object.keys(scores).length) return interaction.reply("ما فيه نقاط للحين، ابدأوا العبوا! 🎮");
    const best   = Object.entries(scores).sort((a, b) => b[1] - a[1]).slice(0, 5);
    const medals = ["🥇","🥈","🥉","4️⃣","5️⃣"];
    const lines  = best.map(([uid, pts], i) => `${medals[i]} <@${uid}> — **${pts}** نقطة`);
    await interaction.reply({ content: "🏆 **المتصدرين**\n" + lines.join("\n"), allowedMentions: { parse: [] } });
  }

  // =================== Dhikr ===================
  else if (commandName === "dhikr") {
    const item = ADHKAR[Math.floor(Math.random() * ADHKAR.length)];
    await interaction.reply({ embeds: [buildAdhkarEmbed(item)], components: [adhkarRow()] });
  }

  // =================== Protection Commands ===================
  else if (commandName === "trust") {
    if (!ownerGuard(interaction)) return;
    const target = interaction.options.getMember("member");
    trustedIds.add(target.id); saveTrusted();
    await interaction.reply(`✅ تمت إضافة ${target} لقائمة الموثوقين`);
  }
  else if (commandName === "untrust") {
    if (!ownerGuard(interaction)) return;
    const target = interaction.options.getMember("member");
    trustedIds.delete(target.id); saveTrusted();
    await interaction.reply(`✅ تمت إزالة ${target} من قائمة الموثوقين`);
  }
  else if (commandName === "trusted") {
    if (!ownerGuard(interaction)) return;
    const people = [...OWNER_IDS.map(id => `<@${id}>`), ...[...trustedIds].filter(id => !OWNER_IDS.includes(id)).map(id => `<@${id}>`)];
    await interaction.reply({
      content: "🛡️ **الموثوقين:**\n" + (people.length ? people.join("\n") : "ما فيه أحد"),
      allowedMentions: { parse: [] },
    });
  }
  else if (commandName === "protection") {
    if (!ownerGuard(interaction)) return;
    const st = v => v ? "🟢" : "🔴";
    await interaction.reply(
      "🛡️ **حالة الحماية**\n" +
      `${st(ANTI_SPAM)} منع السبام (${SPAM_MAX_MSGS} رسائل / ${SPAM_WINDOW_MS/1000}ث)\n` +
      `${st(ANTI_INVITES)} منع روابط الدعوات\n` +
      `${st(ANTI_LINKS)} منع كل الروابط\n` +
      `${st(ANTI_MENTIONS)} منع المنشن الجماعي (+${MAX_MENTIONS})\n` +
      `${st(ANTI_BAD_WORDS && BAD_WORDS.length)} الكلمات الممنوعة (${BAD_WORDS.length})\n` +
      `${st(ANTI_RAID)} ضد الـ Raid (${RAID_JOIN_LIMIT} دخول / ${RAID_WINDOW_MS/1000}ث)\n` +
      `${st(!!MIN_ACCOUNT_AGE_DAYS)} عمر الحساب الأدنى (${MIN_ACCOUNT_AGE_DAYS} يوم)\n` +
      `${st(ANTI_NUKE)} ضد التخريب (${NUKE_LIMIT} عمليات / ${NUKE_WINDOW_MS/1000}ث → ${NUKE_ACTION})\n` +
      `${st(ANTI_BOT_ADD)} منع إضافة بوتات\n` +
      `${st(LOG_CHANNEL_ID !== "0")} روم اللوق`
    );
  }

  // =================== Subscriptions ===================
  else if (commandName === "subpanel") {
    if (!ownerGuard(interaction)) return;
    const embed = new EmbedBuilder()
      .setTitle("🔔 تنبيهات السيرفر بالخاص")
      .setDescription("اضغط الزر لتوصلك إعلانات وتحديثات السيرفر بالخاص.\nتقدر تلغي الاشتراك بأي وقت.")
      .setColor(0x2b2d31);
    await interaction.reply({ embeds: [embed], components: [subscribeRow()] });
  }
  else if (commandName === "broadcast") {
    if (!ownerGuard(interaction)) return;
    await interaction.deferReply({ ephemeral: true });
    const msg = interaction.options.getString("message");
    const targets = [...dmSubs].map(id => guild.members.cache.get(id)).filter(m => m && !m.user.bot);
    if (!targets.length) return interaction.editReply("❌ ما فيه مشتركين للحين");
    const embed = new EmbedBuilder()
      .setDescription(msg).setColor(0xBEC3CD).setTimestamp()
      .setAuthor({ name: guild.name, iconURL: guild.iconURL() })
      .setFooter({ text: "وصلتك لأنك مشترك بالتنبيهات • لإلغاء الاشتراك اضغط زر 🔕 في السيرفر" });
    await interaction.editReply(`⏳ جاري الإرسال لـ ${targets.length} مشترك...`);
    let ok = 0, failed = 0;
    for (const m of targets) {
      try { await m.send({ embeds: [embed] }); ok++; } catch { failed++; }
      await sleep(BROADCAST_DELAY);
    }
    await interaction.channel.send(`✅ تم الإرسال: ${ok} | فشل (خاصهم مقفل): ${failed}`).catch(() => {});
  }
  else if (commandName === "broadcastall") {
    if (!ownerGuard(interaction)) return;
    if (broadcastRunning) return interaction.reply({ content: "❌ فيه إرسال شغال الحين", ephemeral: true });
    const msg   = interaction.options.getString("message");
    const count = guild.members.cache.filter(m => !m.user.bot).size;
    const estMin = Math.round(count * BROADCAST_ALL_DELAY / 60000);
    const row = new ActionRowBuilder().addComponents(
      new ButtonBuilder().setCustomId(`bcast_confirm_${interaction.user.id}`).setLabel("تأكيد الإرسال للجميع").setEmoji("⚠️").setStyle(ButtonStyle.Danger),
      new ButtonBuilder().setCustomId(`bcast_cancel_${interaction.user.id}`).setLabel("إلغاء").setStyle(ButtonStyle.Secondary),
    );
    const sentMsg = await interaction.reply({
      content: `⚠️ بترسل لـ **${count}** عضو بالخاص (تقريباً ${estMin} دقيقة).\nمتأكد؟`,
      components: [row], fetchReply: true,
    });
    pendingBroadcasts.set(sentMsg.id, msg);
  }
  else if (commandName === "cancelbroadcast") {
    if (!ownerGuard(interaction)) return;
    if (!broadcastRunning) return interaction.reply({ content: "❌ ما فيه إرسال شغال", ephemeral: true });
    broadcastCancel = true;
    await interaction.reply("⏹️ جاري الإيقاف...");
  }
});

// =================== Trivia helpers ===================
const triviaGames     = new Map();
const pendingBroadcasts = new Map();

function triviaRow(item, gameId, disabled, correctIdx) {
  return new ActionRowBuilder().addComponents(
    item.options.map((opt, i) =>
      new ButtonBuilder()
        .setCustomId(`trivia_${gameId}_${i}`)
        .setLabel(opt)
        .setStyle(disabled && i === correctIdx ? ButtonStyle.Success : ButtonStyle.Primary)
        .setDisabled(disabled)
    )
  );
}

// =================== Owner guard ===================
function ownerGuard(interaction) {
  if (OWNER_IDS.includes(interaction.user.id) || interaction.user.id === interaction.guild.ownerId) return true;
  interaction.reply({ content: "❌ هذا الأمر للأونرات فقط", ephemeral: true });
  return false;
}

// =================== Broadcast All ===================
async function runBroadcastAll(guild, channel, message) {
  broadcastRunning = true; broadcastCancel = false;
  const members = guild.members.cache.filter(m => !m.user.bot);
  const embed = new EmbedBuilder()
    .setDescription(message).setColor(0xBEC3CD).setTimestamp()
    .setAuthor({ name: guild.name, iconURL: guild.iconURL() })
    .setFooter({ text: `رسالة من إدارة سيرفر ${guild.name}` });
  let ok = 0, closed = 0, stopped = "";
  for (const [, m] of members) {
    if (broadcastCancel) { stopped = "⏹️ تم الإيقاف يدوياً"; break; }
    try { await m.send({ embeds: [embed] }); ok++; }
    catch (e) {
      if (e.code === 40003 || e.status === 429) { stopped = "🛑 ديسكورد حدّ السرعة، توقف الإرسال"; break; }
      closed++;
    }
    await sleep(BROADCAST_ALL_DELAY);
  }
  broadcastRunning = false;
  await channel.send(`📢 انتهى الإرسال. وصلت: **${ok}** | فشل: **${closed}** ${stopped}`).catch(() => {});
}

