// =================== Invite Cache ===================
async function refreshInvites(guild) {
  try {
    const invites = await guild.invites.fetch();
    const map = new Map();
    invites.forEach(inv => map.set(inv.code, inv.uses || 0));
    inviteCache.set(guild.id, map);
  } catch { console.log(`⚠️ ما قدرت أقرأ دعوات ${guild.id}`); }
}
client.on("inviteCreate", inv => {
  const map = inviteCache.get(inv.guild.id) || new Map();
  map.set(inv.code, inv.uses || 0);
  inviteCache.set(inv.guild.id, map);
});
client.on("inviteDelete", inv => {
  const map = inviteCache.get(inv.guild.id);
  if (map) map.delete(inv.code);
});

// =================== Member Join ===================
client.on("guildMemberAdd", async member => {
  if (member.guild.id !== GUILD_ID) return;
  await sendWelcomeDM(member);

  // رتبة تلقائية
  const role = member.guild.roles.cache.get(AUTO_ROLE_ID);
  if (role) {
    await member.roles.add(role, "رتبة تلقائية").catch(e => console.log("❌ الرتبة:", e.message));
  }

  // معرفة الدعوة
  let inviterText = "غير معروف", inviteUsedText = "غير معروف";
  try {
    const oldMap = inviteCache.get(member.guild.id) || new Map();
    const newInvites = await member.guild.invites.fetch();
    const usedInvite = newInvites.find(inv => (inv.uses || 0) > (oldMap.get(inv.code) || 0));
    if (usedInvite) {
      inviterText = usedInvite.inviter ? `<@${usedInvite.inviter.id}>` : "غير معروف";
      inviteUsedText = `\`${usedInvite.code}\` • الاستخدام رقم \`${usedInvite.uses}\``;
    }
    const updated = new Map();
    newInvites.forEach(inv => updated.set(inv.code, inv.uses || 0));
    inviteCache.set(member.guild.id, updated);
  } catch { console.log("⚠️ تعذر تحديد الدعوة"); }

  const welcomeCh = member.guild.channels.cache.get(WELCOME_CHANNEL_ID);
  const rulesCh   = member.guild.channels.cache.get(RULES_CHANNEL_ID);
  const chatCh    = member.guild.channels.cache.get(CHAT_CHANNEL_ID);
  if (!welcomeCh) return;

  const ownersText = OWNER_IDS.map(id => `<@${id}>`).join(" ");
  const embed = new EmbedBuilder()
    .setTitle("حياك الله في السيرفر!")
    .setDescription(
      `أهلاً ${member}, نورت **N8**! 🖤\n\n` +
      `👑 **أونرية السيرفر:** ${ownersText}\n\n` +
      `👤 **يوزر الشخص:** \`${member.user.tag}\`\n` +
      `🔗 **دعوة بواسطة:** ${inviterText}\n` +
      `📨 **Invite used:** ${inviteUsedText}\n\n` +
      `💬 **روم الشات:** ${chatCh || "روم الشات"}\n` +
      `📜 **روم القوانين:** ${rulesCh || "روم القوانين"}\n\n` +
      "نتمنى لك وقت ممتع بين أفراد مجتمع N8، وحياك الله مرة ثانية!"
    )
    .setColor(0xBEC3CD)
    .setImage(WELCOME_IMAGE_URL)
    .setFooter({ text: "N8 • Welcome to the community" });

  await welcomeCh.send({ embeds: [embed] }).catch(e => console.log("❌ الترحيب:", e.message));

  // Raid check
  if (!ANTI_RAID || !inScope(member.guild.id)) return;
  const now = Date.now();
  if (!joinLog.has(member.guild.id)) joinLog.set(member.guild.id, []);
  let dq = joinLog.get(member.guild.id).filter(e => now - e.time < RAID_WINDOW_MS);
  dq.push({ time: now, memberId: member.id });
  joinLog.set(member.guild.id, dq);

  if (raidUntil.get(member.guild.id) > now) { await raidPunish(member); return; }
  if (dq.length >= RAID_JOIN_LIMIT) {
    raidUntil.set(member.guild.id, now + RAID_MODE_MS);
    await protLog(member.guild, `🚨 **هجوم Raid!** دخل ${dq.length} عضو خلال ${RAID_WINDOW_MS/1000}ث — وضع الطوارئ شغال ${RAID_MODE_MS/1000}ث`);
    for (const e of dq) {
      const m = member.guild.members.cache.get(e.memberId);
      if (m) await raidPunish(m);
    }
    joinLog.set(member.guild.id, []);
    return;
  }

  // عمر الحساب
  if (MIN_ACCOUNT_AGE_DAYS) {
    const ageMs = Date.now() - member.user.createdTimestamp;
    const ageDays = Math.floor(ageMs / 86400000);
    if (ageDays < MIN_ACCOUNT_AGE_DAYS) {
      await member.kick(`🛡️ حساب جديد (${ageDays} يوم)`).catch(() => {});
      await protLog(member.guild, `🆕 تم طرد <@${member.id}>: حسابه عمره ${ageDays} يوم`);
    }
  }
});

