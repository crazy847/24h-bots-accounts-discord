  client.user.setPresence({
    status: "dnd",
    activities: [{ name: "by crazy", type: ActivityType.Streaming, url: "https://www.twitch.tv/your_channel" }],
  });

  // الأذكار
  setInterval(async () => {
    const ch = client.channels.cache.get(ADHKAR_CHANNEL_ID);
    if (!ch) return console.log("❌ الأذكار: ما لقيت الروم");
    const item = ADHKAR[Math.floor(Math.random() * ADHKAR.length)];
