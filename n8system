client.on("messageCreate", async message => {
  if (message.author.bot || !message.guild) return;
  const prefix = "!";

  // --- فحص لعبة الكلمة المبعثرة ---
  const word = scrambleGames.get(message.channel.id);
  if (word && normalize(message.content) === normalize(word)) {
    scrambleGames.delete(message.channel.id);
    addPoint(message.guild.id, message.author.id);
    await message.reply(`🎉 ${message.author} صح! الكلمة: **${word}** (+1 نقطة)`);
    return;
  }

  // --- الأوامر بالبريفكس ---
  if (message.content.startsWith(prefix)) {
    const args    = message.content.slice(prefix.length).trim().split(/\s+/);
    const cmdName = args.shift().toLowerCase();
    // يمكن توسيعه لاحقاً إذا احتجت أوامر نص إضافية
    return;
  }

  // --- الحماية (رسائل عادية) ---
  await handleProtection(message);

  // --- الخط التلقائي ---
  if (lineChannels.has(message.channel.id)) {
    await sendLine(message.channel);
  }
});

async function handleProtection(message) {
  const member = message.member;
  if (!member || !inScope(message.guild.id)) return;
  if (isTrusted(member.id, message.guild)) return;
  if (member.permissions.has(PermissionFlagsBits.Administrator) ||
      member.permissions.has(PermissionFlagsBits.ManageMessages)) return;

  const content = message.content || "";
  let reason = null;
  if (ANTI_INVITES && INVITE_RE.test(content))                       reason = "إرسال رابط دعوة";
  else if (ANTI_LINKS && !LINK_FREE_CHANNEL_IDS.includes(message.channel.id) && hasBlockedLink(content)) reason = "إرسال روابط";
  else if (ANTI_MENTIONS && (message.mentions.users.size + message.mentions.roles.size) >= MAX_MENTIONS) reason = "منشن جماعي";
  else if (ANTI_BAD_WORDS && hasBadWord(content))                    reason = "كلمة ممنوعة";

  if (reason) {
    await message.delete().catch(() => {});
    await message.channel.send({ content: `⚠️ ${member} ممنوع: ${reason}` })
      .then(m => setTimeout(() => m.delete().catch(() => {}), 6000)).catch(() => {});
    if (reason === "منشن جماعي") await safeTimeout(member, SPAM_TIMEOUT_MIN, "حماية: منشن جماعي");
    await protLog(message.guild, `🧹 حذف رسالة <@${member.id}> في ${message.channel} | السبب: ${reason}`);
    return;
  }

  if (ANTI_SPAM) {
    const key = `${message.guild.id}:${member.id}`;
    const now = Date.now();
    if (!msgTimes.has(key)) msgTimes.set(key, []);
    let times = msgTimes.get(key).filter(t => now - t < SPAM_WINDOW_MS);
    times.push(now);
    msgTimes.set(key, times);
    if (times.length >= SPAM_MAX_MSGS) {
      msgTimes.set(key, []);
      await message.channel.messages.fetch({ limit: 50 })
        .then(msgs => {
          const toDelete = msgs.filter(m => m.author.id === member.id).first(30);
          message.channel.bulkDelete(toDelete, true).catch(() => {});
        }).catch(() => {});
      const ok = await safeTimeout(member, SPAM_TIMEOUT_MIN, "حماية: سبام");
      await message.channel.send({ content: `🚫 ${member} سبام، ${ok ? "تم كتمه" : "تم حذف رسائله"}.` })
        .then(m => setTimeout(() => m.delete().catch(() => {}), 6000)).catch(() => {});
      await protLog(message.guild, `🚫 سبام من <@${member.id}> (${ok ? "كتم" : "حذف فقط"})`);
    }
  }
}

